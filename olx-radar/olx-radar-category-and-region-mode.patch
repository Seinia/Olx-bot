+@lru_cache(maxsize=1)
+def _regions() -> dict[int, str]:
+    # Отдельного справочника областей нет -- region_id/region_name лежат прямо
+    # в каждой записи города (см. scripts/refresh_cities.py), собираем на лету.
+    out: dict[int, str] = {}
+    for city in _cities().values():
