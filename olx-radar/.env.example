# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш числовой id — узнать у @userinfobot. Бот отвечает только этому аккаунту.
TELEGRAM_OWNER_ID=

DB_PATH=./data/olx.db

# Ниже 20 секунд опрашивать бессмысленно: выдача не обновляется чаще (см. FINDINGS.md, S-07)
POLL_INTERVAL_FAST=25
POLL_INTERVAL_FULL=600
FULL_MAX_PAGES=10

# Через сколько часов без единой находки предупредить, что монитор мог сломаться
SILENCE_ALERT_HOURS=12

# История неактуальных объявлений и снимки цен старше этого срока удаляются раз в сутки.
HISTORY_RETENTION_DAYS=30

# Прокси не нужны для доступа и замедляют запрос втрое. Включать только если
# OLX начнёт блокировать по IP.
PROXY_ENABLED=false
PROXY_LIST_FILE=./proxies.txt

BACKOFF_BASE=2.0
BACKOFF_MAX=1800
LOG_LEVEL=INFO
